# --- Base de données --------------------------------------------------
# Postgres — Supabase ou Neon recommandés. Utilise la "connection pooling
# URL" fournie par ton hébergeur pour DATABASE_URL en production.
#
# ⚠️ Avec le pooler Supabase (host en "...pooler.supabase.com", port 6543),
# ajoute impérativement "?pgbouncer=true" à la fin de l'URL. Sans ce
# paramètre, Prisma provoque des erreurs aléatoires du type
# 'prepared statement "sXX" already exists' en production sur Vercel,
# car pgbouncer partage les connexions entre requêtes d'une façon
# incompatible avec les "prepared statements" par défaut de Prisma.
DATABASE_URL="postgresql://user:password@host:6543/sponsor_ma_saison?pgbouncer=true"

# --- Stripe --------------------------------------------------------------
# Clés de test d'abord (dashboard.stripe.com/test/apikeys), clés live
# ensuite pour la production. Ne jamais committer de vraies clés.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Secret de signature du endpoint webhook (voir README "Configurer Stripe").
# En local avec `stripe listen`, la CLI te donne directement ce secret.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Stockage des logos ----------------------------------------------------
# Vercel Blob (dashboard Vercel > Storage > Blob > Create). Optionnel en
# développement local : sans ce token, les logos sont écrits directement
# dans public/uploads/ pour ne pas bloquer le dev.
BLOB_READ_WRITE_TOKEN=""

# --- Divers ----------------------------------------------------------------
# URL publique du site (utilisée en repli si l'en-tête Origin est absent).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
